<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FuelDashboardApplication"
        android:label="Agents Fuel"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Headless pairing (fleet SSOT: agent-app-bridge-pattern.md):
                 agents fire fueldashboard://import?token=X&url=Y so the phone
                 can redeem a one-time settings token from the desktop server.
                 The long-lived server API key never rides the link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fueldashboard" android:host="import" />
            </intent-filter>
        </activity>

        <service
            android:name=".FuelStatusService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot restore: system-only broadcast (protected), so exported
             is required and safe. Restore runs in worker mode — dataSync
             FGS starts from BOOT_COMPLETED are banned on Android 15+
             targets. -->
        <receiver
            android:name=".FuelStatusBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification stop action: explicit-component PendingIntents
             from this app only — not exported, no intent-filter. -->
        <receiver
            android:name=".FuelStatusStopReceiver"
            android:exported="false" />
    </application>

</manifest>
